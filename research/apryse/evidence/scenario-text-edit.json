{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "https://showcase.apryse.com/"
  },
  "actions": [
    {
      "step_id": "cookies",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Reject Non-Essential"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "edit_category",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "img[src=\"/assets/icons/category-edit.svg\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "open_pdf_text_editing",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "p:text-is(\"PDF Text Editing\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "editing_ready",
      "action": "wait_for_timeout",
      "duration_ms": 12000
    }
  ],
  "capture": {
    "at_end": [
      "dom",
      "accessibility",
      "url",
      "screenshot"
    ],
    "events": [
      "network",
      "console",
      "page-errors",
      "workers"
    ]
  },
  "command_timeout_ms": 60000
}