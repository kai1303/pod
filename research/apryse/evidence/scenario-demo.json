{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "https://showcase.apryse.com/"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 12000
    }
  ],
  "capture": {
    "at_end": [
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "network",
      "console"
    ]
  },
  "command_timeout_ms": 45000
}